x = c(-0.98, 1.00, 2.02, 3.03, 4.00)
y = c(2.44, -1.51, -0.47, 2.54, 7.52)
plot(x,y)
xp = seq(-1,5, by=0.25)
model1 = lm(y ~ x) #linear model y=a+bx (p=1)
yp1 = predict(model1, list(x=xp))
lines(xp,yp1, col='blue')
model2 = lm(y ~ x + I(x^2)) # y = a + bx + c^2 (p=2)
yp2 = predict(model2,list(x=xp))
lines(xp,yp2, col='red')
lines(xp,yp1, col='blue', lwd=3)
lines(xp,yp2, col='red', lwd=3)
lines(xp,yp2, col='red', lwd=3, lty=2)
lines(xp,yp2, col='green', lwd=3, lty=2)
model3 = lm(y ~ x + I(x^2) + I(x^3)) # y = a + bx + c^2 (p=3)
yp3 = predict(model3,list(x=xp))
lines(xp,yp3, col='red', lwd=3, lty=2)
lines(xp,yp2, col='green', lwd=3, lty=2)
lines(xp,yp2, col='green', lwd=3, lty=2)
lines(xp,yp3, col='red', lwd=3, lty=2)
summary(model2)
summary(model3)
